+// maxExpiresAt: момент, когда сессия будет удалена по абсолютному сроку (пусто, если лимита нет).
+func (s *Session) maxExpiresAt(max time.Duration) string {
+	if max <= 0 {
+		return ""
+	}
+	return s.Created.Add(max).UTC().Format(time.RFC3339)
